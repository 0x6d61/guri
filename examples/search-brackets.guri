; Return a bidirectional bracket Map or raise UserError for unmatched brackets.
; code is a Unicode String; positions are Unicode code point indices.
(defn search-brackets [code]
  (let [pc 0
        stack []
        brackets {}]
    (while (< pc (len code))
      (let [command (nth code pc)]
        (cond
          (= command "[")
          (set! stack (append stack pc))

          (= command "]")
          (if (= (len stack) 0)
            (error "] に対応する [ がありません。")
            (let [left (nth stack (- (len stack) 1))]
              (assoc! brackets left pc)
              (assoc! brackets pc left)
              (set! stack (slice stack 0 (- (len stack) 1)))))))
      (set! pc (inc pc)))
    (if (!= (len stack) 0)
      (error "[が閉じられていません。"))
    brackets))

(def pairs (search-brackets "[[]]"))
(println (get pairs 0) (get pairs 1) (get pairs 2) (get pairs 3))
