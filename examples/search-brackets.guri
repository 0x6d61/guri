; Build a bidirectional bracket table. The result's :ok is false for unmatched brackets.
; code is a Unicode String; positions are Unicode code point indices.
(defn search-brackets [code]
  (let [pc 0
        stack []
        brackets {}
        valid true]
    (while (and valid (< pc (len code)))
      (let [command (nth code pc)]
        (cond
          (= command "[")
          (set! stack (append stack pc))

          (= command "]")
          (if (= (len stack) 0)
            (set! valid false)
            (let [left (nth stack (- (len stack) 1))]
              (assoc! brackets left pc)
              (assoc! brackets pc left)
              (set! stack (slice stack 0 (- (len stack) 1)))))))
      (set! pc (inc pc)))
    {:ok (and valid (= (len stack) 0)) :brackets brackets}))

(def result (search-brackets "[[]]"))
(def pairs (:brackets result))
(println (:ok result))
(println (get pairs 0) (get pairs 1) (get pairs 2) (get pairs 3))
