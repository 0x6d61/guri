(println (and false (/ 1 0)))
(println (or "ok" (/ 1 0)))
(println (!= 1 2))
(println (= 1 1.0))
(println (!= 1 1.0))
(println (= 1 1.5))
(println (and) (or) (do))
(println (if 0 true false) (if "" true false) (if [] true false))
(println (if {} true false) (if '() true false) (if nil true false))
(println (if false 1))
