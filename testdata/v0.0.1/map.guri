(def a {:count 0})
(def b (assoc a :count 1))
(println (:count a))
(println (:count b))
(def alias a)
(assoc! alias :count 2)
(println (:count a))
(def copied (update a :count inc))
(println (:count a) (:count copied))
(update! alias :count inc)
(println (:count a))
(println (get a :missing) (:missing a 9))
(println (len (dissoc a :count)) (len a))
(dissoc! alias :count)
(println (len a))
(def nested {:v [1]})
(def shallow (clone nested))
(assoc! (:v shallow) 0 9)
(println (:v nested))
