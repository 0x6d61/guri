(def a [1 2 3])
(def b a)
(assoc! b 0 9)
(println a)
(set! b (append b 4))
(println a)
(println b)
(def shared (slice a 0 1))
(def expanded (append shared 8))
(println a (len shared) (len expanded) (cap shared))
(println (slice shared 2 3))
(def independent (assoc a 0 7))
(println a independent)
(def cloned (clone a))
(assoc! cloned 1 0)
(println a cloned)
(println (reduce + 0 a))
